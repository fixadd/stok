# PostgreSQL / application settings
POSTGRES_DB=stok
POSTGRES_USER=stok
POSTGRES_PASSWORD=change-this-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://stok:change-this-to-a-long-random-password@localhost:5432/stok

# Application security
# Production'da gerçek ve uzun rastgele bir SECRET_KEY kullanın.
SECRET_KEY=change-this-to-a-long-random-secret
APP_ENV=production

# HTTPS kullanıyorsanız true yapın. HTTP test ortamında false bırakılabilir.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=480
